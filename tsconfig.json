{
	"compilerOptions": {
		"module": "Node16",
		"target": "es2021",
		"strict": true,
		"strictFunctionTypes": false,
		"strictBindCallApply": false,
		"noImplicitAny": true,
		"noUnusedParameters": true,
		"noUnusedLocals": true,
		"preserveConstEnums": true,
		"removeComments": true,
		"sourceMap": true,
		"declaration": true,
		"rootDir": ".",
		"allowJs": true,
		"types": [
			"node",
			"mocha"
		]
	},
	"include": [
		"test/**/*",
		"odata-parser.d.ts",
		"patch-to-map-based-cache.js"
	],
	"exclude": [
		"node_modules"
	]
}
